# Core Banking Environment Variables
# Database
POSTGRES_DB=corebanking
POSTGRES_USER=bankuser
POSTGRES_PASSWORD=banksecret
POSTGRES_PORT=5432

# Backend API
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=corebanking;Username=bankuser;Password=banksecret

# Security & JWT
Jwt__Issuer=CoreBankingSystem
Jwt__Audience=CoreBankingClient
Jwt__Secret=SuperSecretBankingKeyThatIsAtLeast32BytesLongForSecurity!
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=7

# Dev Mail Service (Mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Web Client
WEB_PORT=80
